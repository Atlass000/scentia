# ─────────────────────────────────────────────────────────────
# SCENTIA — Environment Variables
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in every value below
# 3. NEVER commit .env.local to git (it is in .gitignore)
# ─────────────────────────────────────────────────────────────

# ── FIREBASE ──────────────────────────────────────────────────
# Firebase Console → Project Settings → Your Apps → Web App → SDK config
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=scentia-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=scentia-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=scentia-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ── STRIPE ────────────────────────────────────────────────────
# Stripe Dashboard → Developers → API Keys → Publishable key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs: Stripe Dashboard → Products → each product → Prices → copy ID
EXPO_PUBLIC_STRIPE_ESSENTIAL_PRICE_ID=price_...
EXPO_PUBLIC_STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
EXPO_PUBLIC_STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...

# ── SECRETS (stored in Firebase, NOT here) ────────────────────
# Run once after firebase login:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
